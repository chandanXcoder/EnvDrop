    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "env",
    "dotenv",
    "secrets",
    "share",
    "encryption",
    "cli",
    "gitignore",
    "pre-commit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chandanXcoder/EnvDrop.git",
