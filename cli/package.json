{
  "name": "envdrop",
  "version": "0.1.0",
  "description": "Share .env files end-to-end encrypted with expiring, burn-after-read links. CLI companion to the EnvDrop VS Code extension.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "envdrop": "dist/envdrop.mjs"
  },
  "files": [
