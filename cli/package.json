  },
  "homepage": "https://github.com/chandanXcoder/EnvDrop#cli",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@envdrop/core": "0.1.0",
    "@envdrop/shared": "0.1.0",
    "@types/node": "^20.19.0",
    "esbuild": "^0.28.0",
    "ignore": "^7.0.5"
  }
}
