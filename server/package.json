{
  "name": "@envdrop/server",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-knowledge blob store for EnvDrop (Cloudflare Worker + Durable Objects).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:web": "node build-web.mjs",
    "build": "npm run build:web && wrangler deploy --dry-run --outdir dist",
    "dev": "npm run build:web && wrangler dev",
    "deploy": "npm run build:web && wrangler deploy",
    "typecheck": "npm run build:web && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@envdrop/shared": "0.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "esbuild": "^0.28.0",
    "wrangler": "^4.40.0"
  }
}
